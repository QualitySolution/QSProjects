<UserControl x:Class="QS.Updater.App.Views.NewVersionView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:QS.Updater.App.ViewModels;assembly=QS.Updater.App"
             xmlns:updates="clr-namespace:QS.Updates;assembly=QS.Updates.Client"
             x:DataType="vm:NewVersionViewModel">
    <Grid Margin="20" RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <Image Width="76" Height="76" Source="avares://QS.Updater.App.Avalonia/Assets/UpdateIllustration.png"
                   VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="Доступна новая версия" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding AvailableVersionText}" FontWeight="SemiBold" />
                    <TextBlock Text="  ·  Установлена версия " Opacity="0.7" />
                    <TextBlock Text="{Binding InstalledVersionText}" Opacity="0.7" />
                </WrapPanel>
                <TextBlock Text="{Binding DbInfoText}" IsVisible="{Binding VisibleDbInfo}" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Text="Что нового" FontWeight="SemiBold" />
        <Border Grid.Row="2" Background="{DynamicResource QsBrushSurface}"
                BorderBrush="{DynamicResource QsBrushBorder}" BorderThickness="1" CornerRadius="6">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ReleaseItems}" Margin="14,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ReleaseItem">
                            <StackPanel Margin="0,0,0,14" Spacing="7">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{Binding Version}" FontWeight="Bold" VerticalAlignment="Center" />
                                    <Panel Grid.Column="1" IsVisible="{Binding HasDatabaseUpdate}"
                                           ToolTip.Tip="{Binding DatabaseUpdateText}" VerticalAlignment="Center">
                                        <Image Source="avares://QS.Updater.App.Avalonia/Assets/db-red.png"
                                               IsVisible="{Binding IsBreakingDatabaseUpdate}" />
                                        <Image Source="avares://QS.Updater.App.Avalonia/Assets/db-violet.png"
                                               IsVisible="{Binding !IsBreakingDatabaseUpdate}" />
                                    </Panel>
                                    <TextBlock Grid.Column="2" Text="{Binding Date}" Opacity="0.7"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <Button Grid.Column="3" Classes="quiet" Content="Прочитать новость"
                                            Command="{Binding OpenNewsCommand}" IsVisible="{Binding HasNews}" />
                                </Grid>
                                <Separator />
                                <TextBlock Text="{Binding Changes}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Spacing="8">
            <WrapPanel Orientation="Horizontal" IsVisible="{Binding VisibleSelectRelease}">
                <TextBlock Text="Установить версию:" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox ItemsSource="{Binding SelectableReleases}" SelectedItem="{Binding SelectedRelease}" MinWidth="140">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="updates:ReleaseInfo"><TextBlock Text="{Binding Version}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </WrapPanel>
            <TextBlock Text="{Binding DbUpdateInfo}" IsVisible="{Binding VisibleDbUpdateInfo}"
                       TextWrapping="Wrap" Foreground="DarkOrange" />
        </StackPanel>

        <Border Grid.Row="4" BorderBrush="{DynamicResource QsBrushBorderSubtle}"
                BorderThickness="0,1,0,0" Padding="0,10,0,0">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Classes="primary" Margin="4,2" Content="Скачать и установить" Command="{Binding InstallCommand}" />
                <Button Margin="4,2" Content="Позже" Command="{Binding LaterCommand}"
                        ToolTip.Tip="Закрыть окно и напомнить об обновлении позже" />
                <Button Classes="quiet" Margin="4,2" Content="Пропустить версию" Command="{Binding SkipVersionCommand}"
                        ToolTip.Tip="Не показывать окно для этой версии до выхода следующей" />
                <Button Classes="quiet" Margin="4,2" Content="Отключить обновления" Command="{Binding OffAutoUpdateCommand}"
                        IsVisible="{Binding VisibleUpdateOff}"
                        ToolTip.Tip="Отключить автоматическую проверку обновлений" />
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
