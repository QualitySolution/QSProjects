<?xml version="1.0" encoding="Windows-1251"?>
<!--Центральный Банк Российской Федерации.
Унифицированные форматы электронных банковских сообщений.

Обмен САБС - УЭО по корпоративным картам

Схемы с описанием прикладных частей электронных сообщений, используемых в расчетной сети Банка России.

-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ed="urn:cbr-ru:ed:v2.0" xmlns:lt="urn:cbr-ru:ed:leaftypes:v2.0" targetNamespace="urn:cbr-ru:ed:v2.0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2026.09.0">
	<xs:include schemaLocation="cbr_ed_objects_v2026.09.0.xsd"/>
	<xs:import namespace="urn:cbr-ru:ed:leaftypes:v2.0" schemaLocation="cbr_ed_leaftypes_v2026.09.0.xsd"/>
	<xs:annotation>
		<xs:documentation>Прикладные части ЭС</xs:documentation>
	</xs:annotation>
	<xs:complexType name="CardDataLineType">
		<xs:annotation>
			<xs:documentation>Список операций по картам.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Oper" type="ed:OperType" minOccurs="0" maxOccurs="unbounded">
				<xs:annotation>
					<xs:documentation>Операции по картам.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="NumberCard" type="lt:Max20TextType" use="required">
			<xs:annotation>
				<xs:documentation>Номер банковской карты.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="AdditionalInfo" type="lt:Max100TextType">
			<xs:annotation>
				<xs:documentation>Дополнительная информация по карте.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="AllSumBeginDayCard" type="lt:BalanceKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Всего средств на начало дня на банковской карте клиента (с учётом зарезервированных и доступных к использованию).</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumRezervBeginDayCard" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма зарезервированных средств на начало дня по банковской карте клиента.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumFreeUseBeginDayCard" type="lt:BalanceKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма доступных средств к использованию на начало дня по банковской карте.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="AllSumPostplCard" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Всего зачислено по соответствующей банковской карте за день.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumRezervPostplCard" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма зарезервированных средств по карте по операциям зачисления.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="AllSumSpisanCard" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Всего списано с соответствующей банковской карты за день.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumRezervSpisanCard" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма зарезервированных средств по карте по операциям списания.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="AllSumEndDayCard" type="lt:BalanceKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Всего доступных средств на конец дня по банковской карте клиента (с учётом зарезервированных и доступных к использованию).</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumRezervEndDayCard" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма зарезервированных средств на конец дня на банковской карте клиента.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumFreeUseEndDayCard" type="lt:BalanceKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма доступных средств к использованию на конец дня на банковской карте клиента.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="OperType">
		<xs:annotation>
			<xs:documentation>Операции по картам.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="NameContragent" type="lt:Max2000TextType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Наименование контрагента, наименование организации-контрагента, с которой клиент осуществлял расчеты с использованием карты, наименование и места расположения пункта выдачи наличных денег, банкомата, терминала или другого технического устройства.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="RecvizContragent" type="lt:Max2000TextType" minOccurs="0" maxOccurs="1">
				<xs:annotation>
					<xs:documentation>Реквизиты контрагента, идентификатор банкомата, электронного терминала или другого технического устройства, предназначенного для совершения операций с использованием карт.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="NumberPP" type="lt:Max9TextType">
			<xs:annotation>
				<xs:documentation>Полный номер платёжного поручения, по которому банком была проведена операция списания или зачисления с использованием банковской карты.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="EPD" type="lt:Max10TextType">
			<xs:annotation>
				<xs:documentation>Уникальный полный номер платёжного поручения в течение операционного дня, присвоенный документу банком.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Date" type="lt:DateType">
			<xs:annotation>
				<xs:documentation>Дата платёжного поручения, по которому банком была проведена операция списания или зачисления с использованием банковской карты.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="VidOper" type="lt:TwoDigitCodeType" use="required">
			<xs:annotation>
				<xs:documentation>Вид операции, совершенной по карте.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumPostpl" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма зачислений по соответствующей карте.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumRezervPostpl" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма зарезервированных средств (по операции зачисления).</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumSpisan" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма списаний по соответствующей карте.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="SumRezervSpisan" type="lt:NotNegativeKopeckAmountType" use="required">
			<xs:annotation>
				<xs:documentation>Сумма зарезервированных средств (по операции списания).</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="RSPlatel" type="lt:AccountNumberRUIDType">
			<xs:annotation>
				<xs:documentation>Расчётный счёт плательщика.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="RSPoluch" type="lt:AccountNumberRUIDType">
			<xs:annotation>
				<xs:documentation>Расчётный счёт получателя.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:element name="ED652" type="ed:ED652"/>
	<xs:complexType name="ED652">
		<xs:annotation>
			<xs:documentation>Информация об операциях клиентов, совершаемых с использованием банковских карт</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="ed:ESID">
				<xs:sequence>
					<xs:element name="TOFKName" type="lt:Max2000TextType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Полное или сокращённое наименование ТОФК.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CardDataLine" type="ed:CardDataLineType" minOccurs="1" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Список операций по картам.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="Number" type="lt:Max30TextType" use="required">
					<xs:annotation>
						<xs:documentation>Уникальный номер документа в течении операционного дня, присвоенный банком.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="OperDate" type="lt:DateType" use="required">
					<xs:annotation>
						<xs:documentation>Дата операций текущего операционного дня.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Account" type="lt:AccountNumberRUIDType" use="required">
					<xs:annotation>
						<xs:documentation>Полный номер расчётного счёта №40116.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="BIK" type="lt:BICRUIDType" use="required">
					<xs:annotation>
						<xs:documentation>БИК банка, в котором открыт счет № 40116.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AllSumBeginDay" type="lt:BalanceKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Всего средств на начало дня по документу (с учётом зарезервированных и доступных к использованию).</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="SumRezervBeginDay" type="lt:NotNegativeKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Сумма зарезервированных средств на начало дня по документу.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="SumFreeUseBeginDay" type="lt:NotNegativeKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Сумма доступных средств к использованию на начало дня по документу.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AllSumPostpl" type="lt:NotNegativeKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Всего зачисленных средств по всем операциям клиента за день (общая сумма поступлений по всем картам клиента).</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AllSumRezervPostpl" type="lt:NotNegativeKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Сумма зарезервированных средств по документу по операциям зачисления.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AllSumSpisan" type="lt:NotNegativeKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Всего списанных средств по всем операциям клиента за день (общая сумма списаний по всем картам клиента).</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AllSumRezervSpisan" type="lt:NotNegativeKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Сумма зарезервированных средств по документу по операциям списания.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="AllSumEndDay" type="lt:BalanceKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Всего доступных средств на конец дня по документу (с учётом зарезервированных и доступных к использованию).</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="SumRezervEndDay" type="lt:NotNegativeKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Сумма зарезервированных средств на конец дня по документу.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="SumFreeUseEndDay" type="lt:BalanceKopeckAmountType" use="required">
					<xs:annotation>
						<xs:documentation>Сумма доступных средств к использованию на конец дня по документу.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>
