<?xml version="1.0" encoding="Windows-1251"?>
<!--Центральный Банк Российской Федерации.
Унифицированные форматы электронных банковских сообщений.

Обмен САБС - УЭО по корпоративным картам

Схемы с описанием прикладных частей электронных сообщений, используемых в расчетной сети Банка России.

-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ed="urn:cbr-ru:ed:v2.0" xmlns:lt="urn:cbr-ru:ed:leaftypes:v2.0" targetNamespace="urn:cbr-ru:ed:v2.0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2026.09.0">
	<xs:include schemaLocation="cbr_ed_objects_v2026.09.0.xsd"/>
	<xs:import namespace="urn:cbr-ru:ed:leaftypes:v2.0" schemaLocation="cbr_ed_leaftypes_v2026.09.0.xsd"/>
	<xs:annotation>
		<xs:documentation>Прикладные части ЭС</xs:documentation>
	</xs:annotation>
	<xs:complexType name="BaseDocType">
		<xs:annotation>
			<xs:documentation>Документ-основание.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="Number" type="lt:Max15TextType" use="required">
			<xs:annotation>
				<xs:documentation>Номер реестра.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="Date" type="lt:DateType" use="required">
			<xs:annotation>
				<xs:documentation>Дата реестра.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="ED651BankAccountDetailsType">
		<xs:annotation>
			<xs:documentation>Реквизиты банковского счета.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="BankName" type="lt:Max160TextType" minOccurs="1">
				<xs:annotation>
					<xs:documentation>Наименование банка.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="Account" type="lt:AccountNumberRUIDType" use="required">
			<xs:annotation>
				<xs:documentation>Полный номер расчётного счёта №40116.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="BIK" type="lt:BICRUIDType" use="required">
			<xs:annotation>
				<xs:documentation>БИК банка, в котором открыт счет № 40116.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="CardInfoType">
		<xs:annotation>
			<xs:documentation>Сведения о карте.</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="CardNumber" type="lt:Max20TextType" minOccurs="1">
				<xs:annotation>
					<xs:documentation>Номер карты.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="AdditionalInfo" type="lt:Max2000TextType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дополнительная информация.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Surname" type="lt:Max150TextType" minOccurs="1">
				<xs:annotation>
					<xs:documentation>Фамилия.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="FirstName" type="lt:Max150TextType" minOccurs="1">
				<xs:annotation>
					<xs:documentation>Имя.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Patronymic" type="lt:Max150TextType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Отчество.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Status" type="lt:TwoDigitCodeType" minOccurs="1">
				<xs:annotation>
					<xs:documentation>Статус.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DateTo" type="lt:DateType" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дата действия по.</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="DateChangeStatus" type="lt:DateType" minOccurs="1">
				<xs:annotation>
					<xs:documentation>Дата изменения статуса.</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="LineNumber" type="lt:Max3NumberType2" use="required">
			<xs:annotation>
				<xs:documentation>Номер строки.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:element name="ED651" type="ed:ED651"/>
	<xs:complexType name="ED651">
		<xs:annotation>
			<xs:documentation>Сведения о выданных картах</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="ed:ESID">
				<xs:sequence>
					<xs:element name="BaseDoc" type="ed:BaseDocType" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Документ-основание.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ServiceTOFK" type="ed:ServiceTOFKType" minOccurs="1">
						<xs:annotation>
							<xs:documentation>Обслуживающий ТОФК/ Расчетный центр.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="ClientInfo" type="ed:CorpClientInfoType" minOccurs="1">
						<xs:annotation>
							<xs:documentation>Сведения о клиенте.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="BankAccountDetails" type="ed:ED651BankAccountDetailsType" minOccurs="1">
						<xs:annotation>
							<xs:documentation>Реквизиты банковского счета.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="CardInfo" type="ed:CardInfoType" minOccurs="1" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Сведения о карте.</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="InitialED" type="ed:EDRefID" minOccurs="0">
						<xs:annotation>
							<xs:documentation>Идентификаторы исходного ЭС ED650.</xs:documentation>
							<xs:documentation>Initial ESIM-request Identifiers.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="Number" type="lt:Max15TextType" use="required">
					<xs:annotation>
						<xs:documentation>Номер документа.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DocDate" type="lt:DateType" use="required">
					<xs:annotation>
						<xs:documentation>Дата документа.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>
