<?xml version="1.0" encoding="Windows-1251"?>
<!--Центральный Банк Российской Федерации.
Унифицированные форматы электронных банковских сообщений.

Обмен САБС - УЭО по корпоративным картам

Схемы с описанием прикладных частей электронных сообщений, используемых в расчетной сети Банка России.

-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ed="urn:cbr-ru:ed:v2.0" xmlns:lt="urn:cbr-ru:ed:leaftypes:v2.0" targetNamespace="urn:cbr-ru:ed:v2.0" elementFormDefault="qualified" attributeFormDefault="unqualified" version="2026.09.0">
	<xs:include schemaLocation="cbr_ed_objects_v2026.09.0.xsd"/>
	<xs:import namespace="urn:cbr-ru:ed:leaftypes:v2.0" schemaLocation="cbr_ed_leaftypes_v2026.09.0.xsd"/>
	<xs:annotation>
		<xs:documentation>Прикладные части ЭС</xs:documentation>
	</xs:annotation>
	<xs:complexType name="ErrCardDataType">
		<xs:annotation>
			<xs:documentation>Сведения об ошибочно указанных картах.</xs:documentation>
		</xs:annotation>
		<xs:attribute name="CardNumber" type="lt:Max20TextType" use="required">
			<xs:annotation>
				<xs:documentation>Номер банковской карты.</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>
	<xs:element name="ED653" type="ed:ED653"/>
	<xs:complexType name="ED653">
		<xs:annotation>
			<xs:documentation>Квитанция</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="ed:ESID">
				<xs:sequence>
					<xs:element name="ErrCardData" type="ed:ErrCardDataType" minOccurs="0" maxOccurs="unbounded">
						<xs:annotation>
							<xs:documentation>Сведения о картах, ошибочно указанных в ЭС ED652».</xs:documentation>
						</xs:annotation>
					</xs:element>
					<xs:element name="InitialED" type="ed:EDRefID" minOccurs="1">
						<xs:annotation>
							<xs:documentation>Идентификаторы исходного ЭС, на которое направляется квитанция.</xs:documentation>
							<xs:documentation>Initial ESIM-request Identifiers.</xs:documentation>
						</xs:annotation>
					</xs:element>
				</xs:sequence>
				<xs:attribute name="CtrlCode" type="lt:TwoDigitCodeType" use="required">
					<xs:annotation>
						<xs:documentation>Код результата контроля.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="CtrlTime" type="xs:dateTime" use="required">
					<xs:annotation>
						<xs:documentation>Дата и время проведения контроля.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Number" type="lt:Max30TextType" use="required">
					<xs:annotation>
						<xs:documentation>Номер обработанного (квитуемого) документа.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="DocDate" type="lt:DateType" use="required">
					<xs:annotation>
						<xs:documentation>Дата обработанного (квитуемого) документа.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
				<xs:attribute name="Account" type="lt:AccountNumberRUIDType" use="required">
					<xs:annotation>
						<xs:documentation>Полный номер расчётного счёта №40116.</xs:documentation>
					</xs:annotation>
				</xs:attribute>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
</xs:schema>
