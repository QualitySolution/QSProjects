<UserControl x:Class="QS.Launcher.Views.Pages.UsersView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QS.Launcher.ViewModels.PageViewModels;assembly=QS.Launcher"
             xmlns:dbme="clr-namespace:QS.DbManagement.Entities;assembly=QS.DbManagement"
             d:DesignHeight="650"
             d:DesignWidth="450"
             x:DataType="vm:UsersVM"
             mc:Ignorable="d">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#30808080">
            <Grid Margin="15,10" ColumnDefinitions="*">
                <Button Margin="5,0" HorizontalAlignment="Stretch"
                        Command="{Binding BackCommand}" Content="Назад" />
            </Grid>
        </Border>

        <Grid Margin="20" VerticalAlignment="Center" RowDefinitions="Auto,*,Auto">
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <Button DockPanel.Dock="Right" Margin="5,0,0,0" VerticalAlignment="Center"
                        Command="{Binding RefreshUsersCommand}" Content="Обновить"
                        IsVisible="{Binding CanManageUsers}" />
                <Label Margin="5,0,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="Bold" Content="Управление пользователями" />
            </DockPanel>

            <ListBox Grid.Row="1" Margin="5" IsVisible="{Binding CanManageUsers}"
                     ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="dbme:DbUserInfo">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                       FontSize="12" Opacity="0.6" Text="отключён" IsVisible="{Binding Disabled}" />
                            <TextBlock VerticalAlignment="Center" Text="{Binding Login}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" ColumnDefinitions="*,*,*" IsVisible="{Binding CanManageUsers}">
                <Button Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" Command="{Binding NewUserCommand}" Content="Создать" />
                <Button Grid.Column="1" Margin="5" HorizontalAlignment="Stretch" Command="{Binding EditUserCommand}" Content="Изменить" />
                <Button Grid.Column="2" Margin="5" HorizontalAlignment="Stretch" Command="{Binding DeleteUserCommand}" Content="Удалить" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
