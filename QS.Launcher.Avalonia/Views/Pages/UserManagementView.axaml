<UserControl x:Class="QS.Launcher.Views.Pages.UserManagementView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QS.Launcher.ViewModels.PageViewModels;assembly=QS.Launcher"
             xmlns:dbme="clr-namespace:QS.DbManagement.Entities;assembly=QS.DbManagement"
             d:DesignHeight="650"
             d:DesignWidth="450"
             x:DataType="vm:UserManagementVM"
             mc:Ignorable="d">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#30808080">
            <Grid Margin="15,10" ColumnDefinitions="*,*">
                <Button Grid.Column="0" Margin="5,0" HorizontalAlignment="Stretch"
                        Command="{Binding BackCommand}" Content="Назад" />
                <Button Grid.Column="1" Margin="5,0" HorizontalAlignment="Stretch" Classes="accent"
                        Command="{Binding SaveCommand}" Content="Сохранить изменения" />
            </Grid>
        </Border>

        <ScrollViewer>
        <StackPanel Margin="20,20,20,10" VerticalAlignment="Center">
            <Label Margin="5" FontSize="16" FontWeight="Bold" Content="Управление пользователями" />

            <!-- Управление другими пользователями - только при наличии прав -->
            <StackPanel IsVisible="{Binding CanManageUsers}">
                <!-- Форма редактирования -->
                <StackPanel IsVisible="{Binding ShowEditForm}">
                    <Label Margin="5,10,5,0" Content="Логин:" />
                    <TextBox Margin="5" Text="{Binding EditLogin}" IsEnabled="{Binding IsNewUser}" />

                    <StackPanel IsVisible="{Binding ShowName}">
                        <Label Margin="5,5,5,0" Content="Имя:" />
                        <TextBox Margin="5" Text="{Binding EditName}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowEmail}">
                        <Label Margin="5,5,5,0" Content="Email:" />
                        <TextBox Margin="5" Text="{Binding EditEmail}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowPhone}">
                        <Label Margin="5,5,5,0" Content="Телефон:" />
                        <TextBox Margin="5" Text="{Binding EditPhone}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowPost}">
                        <Label Margin="5,5,5,0" Content="Должность:" />
                        <TextBox Margin="5" Text="{Binding EditPost}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowComment}">
                        <Label Margin="5,5,5,0" Content="Комментарий:" />
                        <TextBox Margin="5" AcceptsReturn="True" MaxHeight="60" Text="{Binding EditComment}" />
                    </StackPanel>

                    <CheckBox Margin="5,5,5,0" Content="Администратор учётной записи"
                              IsChecked="{Binding EditIsAdmin}" IsVisible="{Binding ShowAdminFlag}" />
                    <CheckBox Margin="5,0" Content="Отключён"
                              IsChecked="{Binding EditDisabled}" IsVisible="{Binding ShowDisabling}" />

                    <Label Margin="5,5,5,0" Content="Пароль:" />
                    <TextBox Margin="5" PasswordChar="•" Text="{Binding EditNewPassword}" Watermark="{Binding PasswordWatermark}" />

                    <!-- Доступ к базам -->
                    <StackPanel IsVisible="{Binding HasSelectedUser}">
                        <Label Margin="5,15,5,0" FontWeight="Bold" Content="Доступ к базам" />

                        <Grid Margin="5,0" ColumnDefinitions="*,52,52,52">
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" Text="Доступ" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" Text="Админ" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" Text="Чтение"
                                       IsVisible="{Binding ShowReadOnly}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding BaseAccesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BaseAccessRowVM">
                                    <StackPanel Margin="5,2">
                                        <Grid ColumnDefinitions="*,52,52,52">
                                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                            <CheckBox Grid.Column="1" MinWidth="0" Padding="0" HorizontalAlignment="Center"
                                                      IsChecked="{Binding HasAccess}" IsEnabled="{Binding CanEdit}" />
                                            <CheckBox Grid.Column="2" MinWidth="0" Padding="0" HorizontalAlignment="Center"
                                                      IsChecked="{Binding IsAdmin}" IsEnabled="{Binding CanEdit}" />
                                            <CheckBox Grid.Column="3" MinWidth="0" Padding="0" HorizontalAlignment="Center"
                                                      IsChecked="{Binding ReadOnly}" IsVisible="{Binding ShowReadOnly}" IsEnabled="{Binding CanEdit}" />
                                        </Grid>
                                        <!-- Прикладные права в таблице users базы - видны, когда доступ выдан -->
                                        <StackPanel Orientation="Horizontal" Margin="12,0,0,2"
                                                    IsVisible="{Binding AppPermissionsVisible}">
                                            <CheckBox MinWidth="0" FontSize="12" Content="удаление"
                                                      IsChecked="{Binding CanDelete}" IsEnabled="{Binding CanEdit}" />
                                            <CheckBox MinWidth="0" Margin="10,0,0,0" FontSize="12" Content="настройки учёта"
                                                      IsChecked="{Binding CanAccountingSettings}" IsEnabled="{Binding CanEdit}" />
                                            <CheckBox MinWidth="0" Margin="10,0,0,0" FontSize="12" Content="дата документа"
                                                      IsChecked="{Binding CanChangeDocumentDate}" IsEnabled="{Binding CanEdit}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="5,0" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="У пользователя глобальные права на весь сервер — доступ к отдельным базам не настраивается"
                                   IsVisible="{Binding BaseAccessLocked}" />

                        <TextBlock Margin="5,0,5,5" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="Недостаточно прав для изменения доступов"
                                   IsVisible="{Binding !CanManageBaseAccess}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
