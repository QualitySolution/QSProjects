<UserControl x:Class="QS.Launcher.Views.Pages.UserManagementView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QS.Launcher.ViewModels.PageViewModels;assembly=QS.Launcher"
             xmlns:dbme="clr-namespace:QS.DbManagement.Entities;assembly=QS.DbManagement"
             d:DesignHeight="650"
             d:DesignWidth="450"
             x:DataType="vm:UserManagementVM"
             mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="20">
            <Label Margin="5" FontSize="16" FontWeight="Bold" Content="Управление пользователями" />

            <!-- Смена своего пароля - доступна всем -->
            <Label Margin="5,10,5,0" FontWeight="Bold" Content="Смена своего пароля" />
            <TextBox Margin="5" PasswordChar="•" Watermark="Новый пароль" Text="{Binding OwnNewPassword}" />
            <TextBox Margin="5" PasswordChar="•" Watermark="Повторите пароль" Text="{Binding OwnConfirmPassword}" />
            <Button Margin="5" HorizontalAlignment="Stretch" Command="{Binding ChangeOwnPasswordCommand}" Content="Сменить пароль" />

            <!-- Управление другими пользователями - только при наличии прав -->
            <StackPanel IsVisible="{Binding CanManageUsers}">
                <Grid Margin="0,15,0,0" ColumnDefinitions="*,Auto,*">
                    <Separator Grid.Column="0" />
                    <Label Grid.Column="1" Margin="5" Opacity="0.6" Content="Пользователи" />
                    <Separator Grid.Column="2" />
                </Grid>

                <ListBox Margin="5" MinHeight="120" MaxHeight="220"
                         ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="dbme:DbUserInfo">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.6" Text="отключён" IsVisible="{Binding Disabled}" />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Login}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid ColumnDefinitions="*,*,*">
                    <Button Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" Command="{Binding NewUserCommand}" Content="Создать" />
                    <Button Grid.Column="1" Margin="5" HorizontalAlignment="Stretch" Command="{Binding DeleteUserCommand}" Content="Удалить" />
                    <Button Grid.Column="2" Margin="5" HorizontalAlignment="Stretch" Command="{Binding RefreshUsersCommand}" Content="Обновить" />
                </Grid>

                <TextBlock Margin="5,15" HorizontalAlignment="Center" Opacity="0.6" TextWrapping="Wrap"
                           Text="Выберите пользователя в списке или создайте нового"
                           IsVisible="{Binding !ShowEditForm}" />

                <!-- Форма редактирования -->
                <StackPanel IsVisible="{Binding ShowEditForm}">
                    <Label Margin="5,10,5,0" Content="Логин:" />
                    <TextBox Margin="5" Text="{Binding EditLogin}" IsEnabled="{Binding IsNewUser}" />

                    <StackPanel IsVisible="{Binding ShowName}">
                        <Label Margin="5,5,5,0" Content="Имя:" />
                        <TextBox Margin="5" Text="{Binding EditName}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowEmail}">
                        <Label Margin="5,5,5,0" Content="Email:" />
                        <TextBox Margin="5" Text="{Binding EditEmail}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowPhone}">
                        <Label Margin="5,5,5,0" Content="Телефон:" />
                        <TextBox Margin="5" Text="{Binding EditPhone}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowPost}">
                        <Label Margin="5,5,5,0" Content="Должность:" />
                        <TextBox Margin="5" Text="{Binding EditPost}" />
                    </StackPanel>

                    <StackPanel IsVisible="{Binding ShowComment}">
                        <Label Margin="5,5,5,0" Content="Комментарий:" />
                        <TextBox Margin="5" AcceptsReturn="True" MaxHeight="60" Text="{Binding EditComment}" />
                    </StackPanel>

                    <CheckBox Margin="5,5,5,0" Content="Администратор учётной записи"
                              IsChecked="{Binding EditIsAdmin}" IsVisible="{Binding ShowAdminFlag}" />
                    <CheckBox Margin="5,0" Content="Отключён"
                              IsChecked="{Binding EditDisabled}" IsVisible="{Binding ShowDisabling}" />

                    <Label Margin="5,5,5,0" Content="Пароль:" />
                    <TextBox Margin="5" PasswordChar="•" Text="{Binding EditNewPassword}" Watermark="{Binding PasswordWatermark}" />

                    <Button Margin="5" HorizontalAlignment="Stretch" Command="{Binding SaveUserCommand}" Content="Сохранить пользователя" />

                    <!-- Доступ к базам -->
                    <StackPanel IsVisible="{Binding HasSelectedUser}">
                        <Label Margin="5,15,5,0" FontWeight="Bold" Content="Доступ к базам" />

                        <Grid Margin="5,0" ColumnDefinitions="*,52,52,52">
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" Text="Доступ" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" Text="Админ" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="12" Opacity="0.6" Text="Чтение"
                                       IsVisible="{Binding ShowReadOnly}" />
                        </Grid>

                        <ItemsControl ItemsSource="{Binding BaseAccesses}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BaseAccessRowVM">
                                    <Grid Margin="5,2" ColumnDefinitions="*,52,52,52">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                        <CheckBox Grid.Column="1" MinWidth="0" Padding="0" HorizontalAlignment="Center"
                                                  IsChecked="{Binding HasAccess}" />
                                        <CheckBox Grid.Column="2" MinWidth="0" Padding="0" HorizontalAlignment="Center"
                                                  IsChecked="{Binding IsAdmin}" />
                                        <CheckBox Grid.Column="3" MinWidth="0" Padding="0" HorizontalAlignment="Center"
                                                  IsChecked="{Binding ReadOnly}" IsVisible="{Binding ShowReadOnly}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Margin="5" HorizontalAlignment="Stretch" Command="{Binding SaveAccessCommand}" Content="Сохранить доступы" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Grid Margin="0,15,0,0" ColumnDefinitions="*,*">
                <Button Grid.Column="0" Margin="5" HorizontalAlignment="Stretch" Command="{Binding BackCommand}" Content="Назад" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
