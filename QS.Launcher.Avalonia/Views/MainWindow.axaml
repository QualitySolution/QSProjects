<Window x:Class="QS.Launcher.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:QS.Launcher.ViewModels;assembly=QS.Launcher"
        Title="QS.Лаунчер"
        Width="450"
        Height="650"
        MinWidth="300"
        MinHeight="300"
        d:DesignHeight="650"
        d:DesignWidth="450"
        x:DataType="vm:MainWindowVM"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Panel>
        <Carousel x:Name="carousel"
                  IsEnabled="{Binding !Navigation.CurrentPage.IsBusy}"
                  SelectedIndex="{Binding Navigation.SelectedIndex}">
            <Carousel.PageTransition>
                <PageSlide Orientation="Horizontal" Duration="0.25" />
            </Carousel.PageTransition>
        </Carousel>

        <Border Background="#80000000" IsVisible="{Binding Navigation.CurrentPage.IsBusy}">
            <ProgressBar Width="220"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         IsIndeterminate="True" />
        </Border>
    </Panel>
</Window>
