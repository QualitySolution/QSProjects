<UserControl x:Class="QS.Views.Widgets.EntityEntryView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Name="Root"
             x:CompileBindings="False"
             mc:Ignorable="d">
    <!-- Поле тянется на всю доступную ширину, кнопки прижаты справа: названия сущностей длинные,
         и в поле фиксированной ширины они обрезались -->
    <Grid ColumnDefinitions="*,Auto,Auto">
        <!-- Поле ввода с кнопкой очистки внутри.
             Текст задаётся из code-behind: биндинг на EntityTitle перезапускал бы поиск
             при каждом выборе сущности. FilterMode=None - список уже отфильтрован запросом. -->
        <Grid Grid.Column="0">
            <AutoCompleteBox x:Name="EntryText"
                             MinWidth="150"
                             VerticalAlignment="Center"
                             Watermark="(не выбрано)"
                             FilterMode="None"
                             MinimumPrefixLength="1"
                             MinimumPopulateDelay="0:0:0.4"
                             Padding="5,5,28,5"/>
            <Button x:Name="ButtonClean"
                    Content="×"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Padding="6,0"
                    Margin="0,0,2,0"
                    Cursor="Hand"
                    ToolTip.Tip="Очистить"
                    IsVisible="{Binding ViewModel.SensitiveCleanButton, ElementName=Root}"
                    Click="OnCleanClicked"/>
        </Grid>
        <Button Grid.Column="1"
                x:Name="ButtonSelect"
                Content="..."
                Width="28"
                Margin="2,0,0,0"
                Padding="2, 6"
                VerticalAlignment="Center"
                IsEnabled="{Binding ViewModel.SensitiveSelectButton, ElementName=Root}"
                Click="OnSelectClicked"/>
        <Button Grid.Column="2"
                x:Name="ButtonView"
                Content="✎"
                Width="28"
                Margin="2,0,0,0"
                Padding="2, 6"
                VerticalAlignment="Center"
                IsEnabled="{Binding ViewModel.SensitiveViewButton, ElementName=Root}"
                Click="OnViewClicked"/>
    </Grid>
</UserControl>
