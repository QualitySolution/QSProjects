<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="using:FluentAvalonia.UI.Controls">
    <!--
        Shared semantic styles for QS desktop applications.
        Applications provide the QsBrush* resources in their own palette.
    -->
    <Styles.Resources>
        <!-- Universal FluentAvalonia mappings. Applications provide only the
             semantic QsBrush* resources and remain in full control of colors. -->
        <Thickness x:Key="ButtonPadding">14,7</Thickness>
        <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
        <!-- Стандартный TabControl в теме Fluent использует очень крупный шрифт заголовков, он выбивается из остального интерфейса. -->
        <x:Double x:Key="TabItemHeaderFontSize">16</x:Double>
        <x:Double x:Key="TabItemMinHeight">36</x:Double>
        <StaticResource x:Key="ButtonBackground" ResourceKey="QsBrushSurface" />
        <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="QsBrushSurfaceHover" />
        <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="QsBrushSelection" />
        <StaticResource x:Key="ButtonForeground" ResourceKey="QsBrushTextPrimary" />
        <StaticResource x:Key="ButtonForegroundPointerOver" ResourceKey="QsBrushTextPrimary" />
        <StaticResource x:Key="ButtonForegroundPressed" ResourceKey="QsBrushTextPrimary" />
        <StaticResource x:Key="ButtonBorderBrush" ResourceKey="QsBrushBorder" />
        <StaticResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="QsBrushBorderStrong" />
        <StaticResource x:Key="ButtonBorderBrushPressed" ResourceKey="QsBrushPrimary" />

        <SolidColorBrush x:Key="NavigationViewItemBackground" Color="Transparent" />
        <StaticResource x:Key="NavigationViewItemBackgroundPointerOver" ResourceKey="QsBrushChromeHover" />
        <StaticResource x:Key="NavigationViewItemBackgroundPressed" ResourceKey="QsBrushChromePressed" />
        <StaticResource x:Key="NavigationViewItemBackgroundSelected" ResourceKey="QsBrushChromePressed" />
        <StaticResource x:Key="NavigationViewItemBackgroundSelectedPointerOver" ResourceKey="QsBrushChromeHover" />
        <StaticResource x:Key="NavigationViewItemBackgroundSelectedPressed" ResourceKey="QsBrushChromePressed" />
        <StaticResource x:Key="NavigationViewItemForeground" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="NavigationViewItemForegroundSelected" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="NavigationViewItemForegroundPointerOver" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="NavigationViewItemForegroundPressed" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="NavigationViewItemForegroundSelectedPointerOver" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="NavigationViewItemForegroundSelectedPressed" ResourceKey="QsBrushChromeText" />

        <StaticResource x:Key="TabViewItemHeaderForeground" ResourceKey="QsBrushChromeTextMuted" />
        <StaticResource x:Key="TabViewItemHeaderForegroundPointerOver" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="TabViewItemHeaderForegroundPressed" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="TabViewItemHeaderCloseButtonForeground" ResourceKey="QsBrushChromeTextMuted" />
        <StaticResource x:Key="TabViewItemHeaderCloseButtonForegroundPointerOver" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="TabViewItemHeaderCloseButtonForegroundPressed" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="TabViewItemHeaderPointerOverCloseButtonForeground" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="TabViewItemHeaderPressedCloseButtonForeground" ResourceKey="QsBrushChromeText" />
        <StaticResource x:Key="TabViewItemHeaderSelectedCloseButtonForeground" ResourceKey="QsBrushChromeText" />
    </Styles.Resources>

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource QsBrushCanvas}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushTextPrimary}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushOnPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushOnPrimary}" />
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimaryHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimaryHover}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimaryHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimaryHover}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushOnPrimary}" />
    </Style>
    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimaryPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimaryPressed}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimaryPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimaryPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushOnPrimary}" />
    </Style>
    <Style Selector="DropDownButton.primary">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushOnPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,7" />
    </Style>
    <Style Selector="DropDownButton.primary /template/ Border#RootBorder">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimary}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource QsBrushOnPrimary}" />
    </Style>
    <Style Selector="DropDownButton.primary:pointerover /template/ Border#RootBorder">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimaryHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimaryHover}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource QsBrushOnPrimary}" />
    </Style>
    <Style Selector="DropDownButton.primary:pressed /template/ Border#RootBorder">
        <Setter Property="Background" Value="{DynamicResource QsBrushPrimaryPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushPrimaryPressed}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource QsBrushOnPrimary}" />
    </Style>
    <Style Selector="Button.quiet">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource QsBrushSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushBorder}" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushBorderStrong}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource QsBrushSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="HeaderedContentControl.card">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <ContentPresenter DockPanel.Dock="Top"
                                      Margin="2,0,0,6"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      TextElement.FontSize="13"
                                      TextElement.FontWeight="SemiBold"
                                      TextElement.Foreground="{DynamicResource QsBrushTextSecondary}" />
                    <Border Background="{DynamicResource QsBrushSurface}"
                            BorderBrush="{DynamicResource QsBrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Border>
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBlock.section-title">
        <Setter Property="Foreground" Value="{DynamicResource QsBrushPrimary}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="fa|FANavigationViewItem:selected">
        <Setter Property="Background" Value="{DynamicResource QsBrushChromePressed}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushChromeText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource QsBrushSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushTextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushBorder}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource QsBrushBorderSubtle}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource QsBrushBorderSubtle}" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource QsBrushSurfaceMuted}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushTextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushBorder}" />
    </Style>
    <Style Selector="DataGridRow:selected">
        <Setter Property="Background" Value="{DynamicResource QsBrushSelection}" />
    </Style>
    <Style Selector="DataGridRow:selected DataGridCell">
        <Setter Property="Background" Value="{DynamicResource QsBrushSelection}" />
        <Setter Property="Foreground" Value="{DynamicResource QsBrushSelectionText}" />
    </Style>

    <Style Selector="fa|FATabView#tabView">
        <Setter Property="Background" Value="{DynamicResource QsBrushChrome}" />
        <Setter Property="Padding" Value="2,0,2,0" />
    </Style>
    <Style Selector="fa|FATabViewItem">
        <Setter Property="Background" Value="{DynamicResource QsBrushChrome}" />
    </Style>
    <Style Selector="fa|FATabViewItem /template/ Border#TabContainerBorder">
        <Setter Property="Background" Value="{DynamicResource QsBrushChrome}" />
    </Style>
    <Style Selector="fa|FATabViewItem:pointerover /template/ Border#TabContainerBorder">
        <Setter Property="Background" Value="{DynamicResource QsBrushChromeHover}" />
    </Style>
    <Style Selector="fa|FATabViewItem:pressed /template/ Border#TabContainerBorder">
        <Setter Property="Background" Value="{DynamicResource QsBrushChromePressed}" />
    </Style>
    <Style Selector="fa|FATabViewItem:selected /template/ Path#SelectedBackgroundPath">
        <Setter Property="Fill" Value="{DynamicResource QsBrushChrome}" />
    </Style>
    <Style Selector="fa|FATabViewItem:selected /template/ Border#TabContainerBorder">
        <Setter Property="Background" Value="{DynamicResource QsBrushChrome}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QsBrushAccent}" />
        <Setter Property="BorderThickness" Value="0,3,0,0" />
    </Style>
    <Style Selector="fa|FATabViewItem /template/ Border#TabSeparator">
        <Setter Property="Background" Value="{DynamicResource QsBrushChromeText}" />
        <Setter Property="Opacity" Value="0.18" />
    </Style>
</Styles>
