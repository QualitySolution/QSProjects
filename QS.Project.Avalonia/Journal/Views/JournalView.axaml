<UserControl x:Class="QS.Journal.Views.JournalView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:journal="clr-namespace:QS.Journal;assembly=QS.Project.Desktop"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:DataType="journal:IJournalViewModel"
             Background="{DynamicResource QsBrushCanvas}"
             mc:Ignorable="d">
    <UserControl.Resources>
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="DataGridCell.number TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <!-- Отступы по краям ячеек и заголовков одинаковые и небольшие, чтобы в таблицах помещалось больше данных -->
        <Style Selector="DataGridCell TextBlock#CellTextBlock">
            <Setter Property="Margin" Value="8,0,8,0" />
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Padding" Value="8,0,8,0" />
        </Style>
    </UserControl.Styles>
    <DockPanel>
        <!-- Панель действий сверху -->
        <ContentControl x:Name="actionsContainer"
                        DockPanel.Dock="Top"
                        Margin="6,6,6,0"
                        Padding="8"
                        Background="{DynamicResource QsBrushSurface}"
                        Content="{Binding ActionsViewModel}"
                        IsVisible="{Binding ActionsViewModel, Converter={x:Static ObjectConverters.IsNotNull}}" />

        <!-- Фильтр -->
        <ContentControl x:Name="filterContainer" 
                        DockPanel.Dock="Top" 
                        Margin="6,6,6,0"
                        IsVisible="{Binding IsFilterShow}" />

        <!-- Поиск -->
        <ContentControl x:Name="searchContainer" 
                        DockPanel.Dock="Top" 
                        Margin="6"
                        Padding="4"
                        Background="{DynamicResource QsBrushSurface}"
                        IsVisible="{Binding SearchEnabled}" />

        <!-- Footer снизу -->
        <TextBlock x:Name="labelFooter" 
                   DockPanel.Dock="Bottom"
                   Margin="8,2,8,5"
                   VerticalAlignment="Center" />

        <!-- Индикатор дозагрузки страницы -->
        <ProgressBar x:Name="loadingIndicator"
                     DockPanel.Dock="Top"
                     Height="2"
                     Margin="5,0"
                     IsIndeterminate="True"
                     IsVisible="False" />

        <!-- Основная таблица -->
        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" 
                BorderThickness="1" 
                Background="{DynamicResource QsBrushSurface}"
                CornerRadius="6"
                Margin="6,0,6,4">
            <ContentControl x:Name="TablePlaceholder" />
        </Border>
    </DockPanel>
</UserControl>
