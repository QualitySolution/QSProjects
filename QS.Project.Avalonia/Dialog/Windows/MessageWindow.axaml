<Window x:Class="QS.Dialog.Windows.MessageWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Width="420"
        MinHeight="160"
        MaxHeight="600"
        SizeToContent="Height"
        Topmost="True"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">
    <Panel>
        <Grid ColumnDefinitions="Auto, *" RowDefinitions="*, Auto">
            <Image x:Name="icon" Width="48" Height="48" Margin="12" VerticalAlignment="Top" />

            <StackPanel x:Name="buttonContainer" Grid.Row="1" Grid.Column="1" Margin="12" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button x:Name="closeButton" Click="OnCloseClick" Content="Закрыть" />
            </StackPanel>

            <ScrollViewer Grid.Column="1" Margin="12" IsScrollChainingEnabled="True">
                <ContentControl x:Name="contentControl">
                    <ContentPresenter Grid.Column="1" Margin="12" TextAlignment="Left" />
                </ContentControl>
            </ScrollViewer>
        </Grid>

    </Panel>

</Window>
