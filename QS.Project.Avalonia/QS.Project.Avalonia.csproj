<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>QS</RootNamespace>
  </PropertyGroup>
  <PropertyGroup Label="Avalonia">
    <AvaloniaUseCompiledBindingsByDefault>True</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaXaml Remove="Views\Widgets\Assets\**" />
    <Compile Remove="Views\Widgets\Assets\**" />
    <EmbeddedResource Remove="Views\Widgets\Assets\**" />
    <None Remove="Views\Widgets\Assets\**" />
    <Compile Update="Navigation\Views\NavigationManagerView.axaml.cs">
      <DependentUpon>NavigationManagerView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Journal\Views\JournalView.axaml.cs">
      <DependentUpon>JournalView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Journal\Views\SearchView.axaml.cs">
      <DependentUpon>SearchView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Journal\Views\ButtonJournalActionsView.axaml.cs">
      <SubType>Code</SubType>
      <DependentUpon>ButtonJournalActionsView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\Widgets\EntityEntryView.axaml.cs">
      <DependentUpon>EntityEntryView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Widgets\ProgressWidget.axaml.cs">
      <DependentUpon>ProgressWidget.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Dialog\Views\ProgressWindowView.axaml.cs">
      <DependentUpon>ProgressWindowView.axaml</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
    <PackageReference Include="System.Reactive" Version="7.0.0" ExcludeAssets="analyzers" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\QS.Project.Core\QS.Project.Core.csproj" />
    <ProjectReference Include="..\QS.Project.Desktop\QS.Project.Desktop.csproj" />
    <ProjectReference Include="..\QS.Utilities\QS.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="Journal\Views\SearchView.axaml" />
    <AdditionalFiles Include="Navigation\Views\NavigationManagerView.axaml" />
  </ItemGroup>
</Project>
