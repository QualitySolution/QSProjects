<UserControl x:Class="QS.Deletion.Views.DeletionProcessView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignWidth="420"
             mc:Ignorable="d">
	<StackPanel Margin="12" Spacing="8" MinWidth="400">
		<TextBlock x:Name="textOperation" HorizontalAlignment="Center" />
		<ProgressBar x:Name="progressOperation" Minimum="0" Maximum="1" Height="16" />
		<Button Content="Отмена" HorizontalAlignment="Center" Click="OnButtonCancelClicked" />
	</StackPanel>
</UserControl>
